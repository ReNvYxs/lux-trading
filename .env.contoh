# =====================================================================
#  LUX - Modul Trading Multi-Strategi Binance Futures
#  TEMPLATE KONFIGURASI KREDENSIAL
# =====================================================================
#
#  CARA PAKAI (PowerShell / Windows):
#     copy .env.contoh .env
#     notepad .env          <- isi nilainya, lalu simpan
#     python main.py
#
#  CARA PAKAI (bash / Linux / macOS):
#     cp .env.contoh .env && nano .env && python3 main.py
#
#  ATURAN KEAMANAN:
#  1. Berkas `.env` SUDAH masuk .gitignore - JANGAN pernah di-commit dan
#     jangan pernah dikirim lewat chat/screenshot. Yang boleh dicommit
#     hanyalah berkas contoh ini (tanpa nilai asli).
#  2. Kredensial TESTNET dan LIVE memakai nama variabel BERBEDA TOTAL.
#     Sistem TIDAK PERNAH memakai kunci testnet untuk endpoint live atau
#     sebaliknya - base URL ditentukan murni oleh mode, bukan oleh berkas ini.
#  3. Variabel lingkungan yang sudah diset di shell MENANG atas berkas ini.
#  4. Baris yang dikosongkan = fitur terkait otomatis nonaktif (untuk
#     Telegram) atau memakai nilai default (untuk parameter trading).
# =====================================================================


# ---------------------------------------------------------------------
# 1. TELEGRAM (opsional - untuk notifikasi sinyal, entry, SL/TP, galat)
# ---------------------------------------------------------------------
# Token bot: buat lewat @BotFather -> /newbot -> salin token yang diberikan.
# Chat ID  : kirim satu pesan ke bot Anda, lalu buka
#            https://api.telegram.org/bot<TOKEN>/getUpdates dan salin
#            nilai "chat":{"id": ... }. Untuk grup, ID biasanya diawali "-".
# Kosongkan keduanya bila belum mau memakai Telegram - sistem tetap jalan.
LUX_TELEGRAM_BOT_TOKEN=
LUX_TELEGRAM_CHAT_ID=
# Saklar cepat: isi 0/false untuk membisukan notifikasi tanpa menghapus token.
LUX_TELEGRAM_AKTIF=1


# ---------------------------------------------------------------------
# 2. BINANCE FUTURES *TESTNET*  (uang MAINAN - untuk uji coba)
# ---------------------------------------------------------------------
# Daftar & buat API key di: https://testnet.binancefuture.com
# JANGAN isi baris ini dengan kunci akun asli Anda.
LUX_BINANCE_TESTNET_API_KEY=
LUX_BINANCE_TESTNET_API_SECRET=


# ---------------------------------------------------------------------
# 3. BINANCE FUTURES *LIVE*  (UANG ASLI - risiko kerugian nyata)
# ---------------------------------------------------------------------
# Buat di https://www.binance.com -> API Management.
# Sangat disarankan: aktifkan pembatasan IP, dan JANGAN beri izin penarikan
# (withdrawal) pada API key ini. Cukup izin "Enable Futures".
LUX_BINANCE_LIVE_API_KEY=
LUX_BINANCE_LIVE_API_SECRET=

# --- GERBANG KEAMANAN MODE LIVE (2 lapis, keduanya WAJIB lolos) ---
# Lapis 1: argumen baris perintah `--konfirmasi-live` (atau konfirmasi ketik
#          ulang di menu interaktif `python main.py`).
# Lapis 2: variabel di bawah ini, harus SAMA PERSIS dengan frasa berikut.
# Biarkan KOSONG selama Anda belum benar-benar siap memakai dana asli.
# Isi dengan: SAYA_PAHAM_INI_AKUN_LIVE_DANA_ASLI
LUX_LIVE_KONFIRMASI=


# ---------------------------------------------------------------------
# 4. PARAMETER TRADING (opsional - semua punya nilai default yang aman)
# ---------------------------------------------------------------------
# ---------------------------------------------------------------------------
# PEMILIHAN PAIR & TIMEFRAME
# KEBIJAKAN 4 Agu 2026: .env adalah KONFIGURASI, bukan batasan. Sistem TIDAK
# BTC-centric dan TIDAK 15m-centric.
#
#   LUX_SIMBOL KOSONG  -> engine memindai pasar Binance sendiri dan memilih
#                         25-50 pair paling likuid (mode multi-pair, DEFAULT).
#   LUX_SIMBOL diisi   -> mode satu pair (uji terarah saja), mis. BTCUSDT.
#
#   LUX_TF_ENTRY KOSONG-> TF entry mengikuti kontrak strategi per horizon
#                         (scalping: 1m/5m/15m, intraday: 15m/1h/4h).
#   LUX_TF_ENTRY diisi -> paksa TF tertentu; boleh daftar dipisah koma (15m,1h).
# ---------------------------------------------------------------------------
LUX_SIMBOL=
LUX_TF_ENTRY=
# Timeframe konteks (multi-TF), dipisah koma. Kosong = mode single-TF.
# Contoh: LUX_TF_KONTEKS=1h    atau    LUX_TF_KONTEKS=1h,4h
LUX_TF_KONTEKS=
# Horizon auto-entry: scalping | intraday.
# (swing sengaja TIDAK bisa auto-entry - selamanya signal-only.)
LUX_HORIZON=intraday
# Batas leverage yang boleh dipakai perhitungan ukuran posisi.
LUX_LEVERAGE_MAKS=20
# Margin konflik skor antar strategi; selisih < nilai ini = TIDAK ADA entry.
LUX_MARGIN_KONFLIK=5
# Jeda antar polling data real-time, dalam detik.
LUX_INTERVAL_POLL=15
# Override saldo untuk perhitungan risiko. Kosong = tarik saldo asli dari akun.
LUX_BALANCE=
# Batas jumlah siklus polling (berguna untuk uji singkat). Kosong = tanpa batas.
LUX_MAKS_SIKLUS=


# ---------------------------------------------------------------------
# 5. BACKTEST (opsional)
# ---------------------------------------------------------------------
# Folder berisi CSV OHLCV mentah. Kosong = dataset_masuk/ekstrak/data_upload
LUX_DATA_DIR=

# ---------------------------------------------------------------------
# 5. PEMINDAI PASAR (mode multi-pair) - semua opsional
# Semua nilai di bawah hanya MENYESUAIKAN kriteria likuiditas; tidak ada
# daftar pair hardcode. Kosongkan untuk memakai default engine.
# ---------------------------------------------------------------------
# Jumlah pair minimum/maksimum yang boleh aktif (default 25 s/d 50).
LUX_PINDAI_MIN_PAIR=
LUX_PINDAI_MAKS_PAIR=
# Ambang likuiditas 24 jam.
LUX_PINDAI_MIN_QUOTE_VOLUME=
LUX_PINDAI_MIN_JUMLAH_TRADE=
# Ambang mikrostruktur: spread maksimum (bps) & kedalaman buku minimum (USD).
LUX_PINDAI_MAKS_SPREAD_BPS=
LUX_PINDAI_MIN_KEDALAMAN_USD=
# Umur cache hasil pemindaian sebelum dipindai ulang (detik, default 1800).
LUX_PINDAI_TTL_DETIK=
# Simbol yang tidak boleh diperdagangkan, dipisah koma. Contoh: LUX_PINDAI_DAFTAR_HITAM=XYZUSDT
LUX_PINDAI_DAFTAR_HITAM=
# Batas total runner (pair x rencana TF) agar RAM/rate-limit aman (default 120).
LUX_MAKS_RUNNER=

# ---------------------------------------------------------------------
# 6. SIZING, LEVERAGE & RR BERSIH
# CATATAN PENTING: LUX_LEVERAGE_MAKS adalah BATAS ATAS, bukan leverage tetap.
# Engine menghitung leverage OTOMATIS per setup dengan urutan:
#   Risk -> Position Size/Notional -> Required Margin -> Optimal Leverage
# sehingga leverage bisa berbeda tiap pair/setup dan tidak pernah statis x5/x10.
# ---------------------------------------------------------------------
# Porsi maksimum saldo yang boleh terpakai sebagai margin satu posisi (0-1, default 0.5).
LUX_PORSI_MARGIN_MAKS=
# RR BERSIH minimum (setelah fee masuk+keluar dan slippage) agar setup diterima.
# Kosong = gerbang RR bersih nonaktif (gerbang biaya di eksekusi/biaya.py tetap aktif).
LUX_RR_BERSIH_MIN=
